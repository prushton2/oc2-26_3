{
  "multipart": [
    {
      "apply": {
        "model": "oc2:block/cable_base"
      },
      "when": {
        "AND": [
          {
            "has_cable": "true",
            "has_facade": "false"
          },
          {
            "OR": [
              {
                "connection_down": "!none"
              },
              {
                "connection_up": "!none"
              },
              {
                "connection_north": "!none"
              },
              {
                "connection_south": "!none"
              },
              {
                "connection_west": "!cable"
              },
              {
                "connection_east": "!cable"
              }
            ]
          },
          {
            "OR": [
              {
                "connection_down": "!cable"
              },
              {
                "connection_up": "!cable"
              },
              {
                "connection_north": "!none"
              },
              {
                "connection_south": "!none"
              },
              {
                "connection_west": "!none"
              },
              {
                "connection_east": "!none"
              }
            ]
          },
          {
            "OR": [
              {
                "connection_down": "!none"
              },
              {
                "connection_up": "!none"
              },
              {
                "connection_north": "!cable"
              },
              {
                "connection_south": "!cable"
              },
              {
                "connection_west": "!none"
              },
              {
                "connection_east": "!none"
              }
            ]
          }
        ]
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_straight",
        "y": 90
      },
      "when": {
        "has_cable": "true",
        "has_facade": "false",
        "connection_down": "none",
        "connection_up": "none",
        "connection_north": "none",
        "connection_south": "none",
        "connection_west": "cable",
        "connection_east": "cable"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_straight",
        "x": 90
      },
      "when": {
        "has_cable": "true",
        "has_facade": "false",
        "connection_down": "cable",
        "connection_up": "cable",
        "connection_north": "none",
        "connection_south": "none",
        "connection_west": "none",
        "connection_east": "none"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_straight"
      },
      "when": {
        "has_cable": "true",
        "has_facade": "false",
        "connection_down": "none",
        "connection_up": "none",
        "connection_north": "cable",
        "connection_south": "cable",
        "connection_west": "none",
        "connection_east": "none"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_link",
        "x": -90,
        "y": 270
      },
      "when": {
        "connection_down": "cable",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_plug",
        "x": -90,
        "y": 270
      },
      "when": {
        "connection_down": "interface",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_link",
        "x": 90,
        "y": 270
      },
      "when": {
        "connection_up": "cable",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_plug",
        "x": 90,
        "y": 270
      },
      "when": {
        "connection_up": "interface",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_link",
        "y": 180
      },
      "when": {
        "connection_north": "cable",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_plug",
        "y": 180
      },
      "when": {
        "connection_north": "interface",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_link"
      },
      "when": {
        "connection_south": "cable",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_plug"
      },
      "when": {
        "connection_south": "interface",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_link",
        "y": 90
      },
      "when": {
        "connection_west": "cable",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_plug",
        "y": 90
      },
      "when": {
        "connection_west": "interface",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_link",
        "y": 270
      },
      "when": {
        "connection_east": "cable",
        "has_facade": "false"
      }
    },
    {
      "apply": {
        "model": "oc2:block/cable_plug",
        "y": 270
      },
      "when": {
        "connection_east": "interface",
        "has_facade": "false"
      }
    }
  ]
}
